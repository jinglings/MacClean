# /etc/macclean-server.env  (chmod 640, owner root:macclean)
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
DATA_DIR=/var/lib/macclean
PUBLIC_BASE_URL=https://thulem.com
TIMEZONE=Asia/Shanghai
# Optional: pin the admin password here instead of the DB (generate with `node src/cli.js hash-password`).
# When set, the in-app "change password" is disabled and first-run setup is skipped.
# ADMIN_PASSWORD_HASH=salt:hash
# ACCESS_LOG=1
